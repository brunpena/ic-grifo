# ---------- Aplicação ----------
APP_ENV=development
LOG_LEVEL=INFO
# Domínios do front separados por vírgula
CORS_ORIGINS=http://localhost:3000

# ---------- Login (cookie de sessão) ----------
SESSION_DAYS=30
# Vazio = HTTPS só em produção (APP_ENV=production)
SESSION_COOKIE_SECURE=
# lax (front e API no mesmo site) ou none (sites diferentes; exige HTTPS)
SESSION_COOKIE_SAMESITE=lax

# ---------- Banco (Postgres + pgvector) ----------
# Local (docker-compose.dev.yml):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/icgrifo
# Supabase (session pooler ou conexão direta):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# true somente se usar o pooler em modo transação (porta 6543)
DATABASE_PGBOUNCER=false
DATABASE_POOL_SIZE=5
# Usado apenas pelos testes que precisam de banco
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/icgrifo_test

# ---------- Armazenamento de arquivos ----------
# local (pasta no disco) ou supabase (Supabase Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
SUPABASE_URL=https://<ref>.supabase.co
# Chave service_role (nunca exponha no front)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# ---------- Limites ----------
MAX_UPLOAD_MB=50
# Requisições por minuto, por IP, nas rotas que chamam a LLM
LLM_RATE_LIMIT_PER_MINUTE=20

# ---------- LLM (Anthropic) ----------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Blocos processados em paralelo na extração de regras
LLM_MAX_CONCURRENCY=4
LLM_CHUNK_CHARS=12000
LLM_CHUNK_OVERLAP=1500

# ---------- Embeddings ----------
# local (sentence-transformers) ou api
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Precisa bater com o modelo (e5-small = 384). Mudar exige nova migration.
EMBEDDING_DIM=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
