# ---------- Aplicação ----------
APP_ENV=development
LOG_LEVEL=INFO
# Domínios do front separados por vírgula
CORS_ORIGINS=http://localhost:3000

# ---------- Login (cookie de sessão) ----------
SESSION_DAYS=30
# Vazio = HTTPS só em produção (APP_ENV=production)
SESSION_COOKIE_SECURE=
# lax (front e API no mesmo site) ou none (sites diferentes; exige HTTPS)
SESSION_COOKIE_SAMESITE=lax

# ---------- Banco (Postgres + pgvector) ----------
# Local (docker-compose.dev.yml):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/icgrifo
# Supabase (session pooler ou conexão direta):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# true somente se usar o pooler em modo transação (porta 6543)
DATABASE_PGBOUNCER=false
DATABASE_POOL_SIZE=5
# Usado apenas pelos testes que precisam de banco
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/icgrifo_test

# ---------- Armazenamento de arquivos ----------
# local (pasta no disco) ou supabase (Supabase Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
SUPABASE_URL=https://<ref>.supabase.co
# Chave service_role (nunca exponha no front)
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# ---------- Limites ----------
MAX_UPLOAD_MB=50
# Bases de dados (CSV)
MAX_DATASET_MB=20
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=200
# Documentos por link: segundos para baixar o arquivo (o tamanho segue MAX_UPLOAD_MB)
URL_FETCH_TIMEOUT_SECONDS=20
# Texto colado, em caracteres
MAX_PASTED_CHARS=1000000
# Requisições por minuto, por IP, nas rotas que chamam a LLM
LLM_RATE_LIMIT_PER_MINUTE=20

# ---------- LLM (Gemini) ----------
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Raciocínio do modelo na extração de regras (low|medium|high; vazio = padrão do modelo)
GEMINI_THINKING_LEVEL=low
# Blocos em paralelo na extração de regras (o plano gratuito tem cota por minuto e por dia,
# por modelo). Blocos acima de ~12 mil caracteres fazem a IA deixar regras passar.
LLM_MAX_CONCURRENCY=6
# Segundos sem resposta do Gemini até repetir a mesma requisição e usar a primeira que
# voltar (0 = desligado). Corta esperas de minutos quando a API está sob carga.
LLM_HEDGE_SECONDS=25
LLM_CHUNK_CHARS=12000
LLM_CHUNK_OVERLAP=400

# ---------- Embeddings ----------
# local (sentence-transformers) ou api
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Precisa bater com o modelo (e5-small = 384). Mudar exige nova migration.
EMBEDDING_DIM=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
